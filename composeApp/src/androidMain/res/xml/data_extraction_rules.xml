<?xml version="1.0" encoding="utf-8"?>
<!--
    Règles d'extraction (Android 12+, API 31+) : même périmètre que backup_rules.xml,
    pour la sauvegarde cloud ET le transfert appareil-à-appareil.
    La base patients Room (databases/vetnutri.db) et les exports locaux (files/backups,
    files/data) sont exclus ; les préférences restent transférables.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="data" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="data" />
    </device-transfer>
</data-extraction-rules>
