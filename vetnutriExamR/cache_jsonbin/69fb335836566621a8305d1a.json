nIl faut aussi veiller à la bonne hydratation de l'animal.\nJe peux conseiller de rendre l'alimentation ludique, en cachant par exemple des croquettes dans des jeux. Je peux suggérer au propriétaire d'augmenter progressivement le temps d'activité de son chien afin de limiter le risque d'une nouvelle prise de poids (ça ne fera pas perdre du poids). Enfin pour augmenter la sassiété, je peux proposer de donner des haricots verts en conserve ou des courgettes à son chien mais sachant que le propiétaire veut une alimentation commerciale c'est pas forcément judicieux. ","prescriptionSelectedConseilIds":[],"prescriptionLocalHtmlSections":[],"prescriptionSelectedRationIds":["33e267b2-2b7e-4f81-a9c8-d3eda109e51a"],"supplementalVariables":[],"rations":[{"uuid":"dfc2f2bc-5de6-4a74-8e77-b9cb8d43b21a","consultationId":"ef807a66-a16f-4876-9422-ab54a32be56d","name":"Ration actuelle","coef":1,"isCurrent":true,"number":1,"specie":"","isRecipe":false,"description":"","items":[{"uuid":"9a4e295a-fd42-4c9b-88f5-50382c0054da","foodId":"RC-23-148","quantity":300,"proportion":0,"weight":1,"category":0,"density":0}]},{"uuid":"33e267b2-2b7e-4f81-a9c8-d3eda109e51a","consultationId":"ef807a66-a16f-4876-9422-ab54a32be56d","name":"Nouvelle ration","coef":1,"isCurrent":false,"number":1,"specie":"","isRecipe":false,"description":"","items":[{"uuid":"0c165ec0-449d-4f09-a718-463c2568dec1","foodId":"M489","quantity":250,"proportion":0,"weight":1,"category":0,"density":0}]}]}]}],"foods":[{"uuid":"RC-23-148","name":"Adult","group":"ALL","kind":"COMPLET","brand":"Royal Canin","price":0,"categoryPrice":"v","ingredients":"maïs, protéines de volaille déshydratées, riz, farine de blé graisses animales, hydrolysat de protéines animales, pulpe de betterave, protéines de porc déshydratées, gluten de blé*, sels minéraux, huile de soja, huile de poisson, fructo-oligo-saccharides, huile de bourrache, extrait de rose d'inde (source de lutéine).","gamme":"Veterinary","presentation":"NO","presentationQuantity":0,"de